<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.view.MenuView"
      alignment="CENTER" spacing="20"
      prefWidth="400" prefHeight="500"
      style="-fx-background-color: #ddd345;">

    <padding>
        <Insets top="40" bottom="40" left="40" right="40"/>
    </padding>

    <Label text="ЗМЕЙКА"
           style="-fx-font-size: 48; -fx-text-fill: #09b317; -fx-font-weight: bold;"/>

    <Label text="Главное меню"
           style="-fx-font-size: 18; -fx-text-fill: #5e592b;"/>

    <VBox alignment="CENTER" spacing="10">
        <padding>
            <Insets top="30" bottom="0" left="0" right="0"/>
        </padding>
        <Label text="Выберите сложность:"
               style="-fx-font-size: 14; -fx-text-fill: #5e592b;"/>
        <Button text="Лёгкий" onAction="#onEasy"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 16;"/>
        <Button text="Нормальный" onAction="#onNormal"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 16;"/>
        <Button text="Сложный" onAction="#onHard"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 16;"/>
        <Button text="Рекорд" onAction="#onRecord"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 16;">
            <VBox.margin>
                <Insets top="20" bottom="0" left="0" right="0"/>
            </VBox.margin>
        </Button>
        <Button text="Выйти" onAction="#onExit"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 16;"/>
    </VBox>

</VBox>
