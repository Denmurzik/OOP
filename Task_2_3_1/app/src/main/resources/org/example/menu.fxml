<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.view.MenuView"
      alignment="CENTER" spacing="15"
      prefWidth="450" prefHeight="650"
      style="-fx-background-color: #ddd345;">

    <padding>
        <Insets top="30" bottom="30" left="40" right="40"/>
    </padding>

    <Label text="ЗМЕЙКА"
           style="-fx-font-size: 48; -fx-text-fill: #09b317; -fx-font-weight: bold;"/>

    <Label text="Главное меню"
           style="-fx-font-size: 18; -fx-text-fill: #5e592b;"/>

    <VBox alignment="CENTER" spacing="8">
        <padding>
            <Insets top="15" bottom="0" left="0" right="0"/>
        </padding>
        <Label text="Количество противников (0–4):"
               style="-fx-font-size: 14; -fx-text-fill: #5e592b; -fx-font-weight: bold;"/>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Жадный (Greedy):"
                   style="-fx-font-size: 13; -fx-text-fill: #c0392b; -fx-min-width: 180;"/>
            <Spinner fx:id="greedySpinner" prefWidth="80"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Случайный (Random):"
                   style="-fx-font-size: 13; -fx-text-fill: #8e44ad; -fx-min-width: 180;"/>
            <Spinner fx:id="randomSpinner" prefWidth="80"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Охотник (Hunter):"
                   style="-fx-font-size: 13; -fx-text-fill: #2c3e50; -fx-min-width: 180;"/>
            <Spinner fx:id="hunterSpinner" prefWidth="80"/>
        </HBox>
    </VBox>

    <VBox alignment="CENTER" spacing="8">
        <padding>
            <Insets top="15" bottom="0" left="0" right="0"/>
        </padding>
        <Label text="Выберите сложность:"
               style="-fx-font-size: 14; -fx-text-fill: #5e592b; -fx-font-weight: bold;"/>
        <Button text="Лёгкий" onAction="#onEasy"
                prefWidth="200" prefHeight="35"
                style="-fx-font-size: 16;"/>
        <Button text="Нормальный" onAction="#onNormal"
                prefWidth="200" prefHeight="35"
                style="-fx-font-size: 16;"/>
        <Button text="Сложный" onAction="#onHard"
                prefWidth="200" prefHeight="35"
                style="-fx-font-size: 16;"/>
        <Button text="Рекорд" onAction="#onRecord"
                prefWidth="200" prefHeight="35"
                style="-fx-font-size: 16;">
            <VBox.margin>
                <Insets top="15" bottom="0" left="0" right="0"/>
            </VBox.margin>
        </Button>
        <Button text="Выйти" onAction="#onExit"
                prefWidth="200" prefHeight="35"
                style="-fx-font-size: 16;"/>
    </VBox>

</VBox>
